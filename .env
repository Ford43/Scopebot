# ===== LLM (Ollama) =====
MODEL_NAME=qwen2.5:1.5b

# ===== Embedding Model =====
EMBEDDING_MODEL=BAAI/bge-m3

# ===== Vector DB =====
VECTOR_DB_PATH=vector_db

# ===== Retriever =====
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=100

# ===== Debug =====
DEBUG=false

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql://postgres:123456789@localhost:5432/scopebot

# ===== JWT Auth =====
SECRET_KEY=scope-bot-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
