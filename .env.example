# ===== LLM (Ollama) =====
# ชื่อ model ที่ pull มาจาก Ollama
# ตัวเลือก: qwen2.5:1.5b | qwen2.5:7b | llama3.2:3b
MODEL_NAME=qwen2.5:1.5b

# ===== Embedding Model =====
# ดาวน์โหลดอัตโนมัติจาก HuggingFace ครั้งแรก (~1.5 GB)
EMBEDDING_MODEL=BAAI/bge-m3

# ===== Vector DB =====
VECTOR_DB_PATH=vector_db

# ===== Retriever =====
# จำนวน chunks ที่ดึงมาใช้ตอบแต่ละคำถาม
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=100

# ===== Debug =====
# true = แสดง debug log | false = ปิด (ใช้ใน production)
DEBUG=false

# ===== Database =====
# PostgreSQL (แนะนำ)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/scopebot
# SQLite สำหรับ development แบบเร็ว (สำรอง)
# DATABASE_URL=sqlite:///./scopebot.db

# ===== CORS =====
# รายการ frontend origins คั่นด้วย comma (ห้ามใช้ * ถ้า allow_credentials=true)
# ตอน deploy ให้ใส่ domain จริง เช่น https://app.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== JWT Auth =====
# สำคัญ: เปลี่ยนเป็น random string ก่อน deploy
# สร้างด้วย: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_HEX_STRING
ALGORITHM=HS256
# อายุ token (นาที) — 1440 = 24 ชั่วโมง
ACCESS_TOKEN_EXPIRE_MINUTES=1440
