# ===== LLM (Ollama) =====
# ชื่อ model ที่ pull มาจาก Ollama
# ตัวเลือก: qwen2.5:1.5b | qwen2.5:7b | llama3.2:3b
MODEL_NAME=qwen2.5:1.5b

# ===== Embedding Model =====
# ดาวน์โหลดอัตโนมัติจาก HuggingFace ครั้งแรก (~1.5 GB)
EMBEDDING_MODEL=BAAI/bge-m3

# ===== Vector DB =====
VECTOR_DB_PATH=vector_db

# ===== Retriever =====
TOP_K=5
# หัวข้อยาว (เช่น ระเบียบหลายข้อ) แนะนำ 800–1000 แล้วอัปโหลดเอกสารใหม่
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ===== Debug =====
# true = แสดง debug log + ลิงก์รีเซ็ตรหัสผ่านใน API เมื่อยังไม่มี SMTP
# pilot บริษัท: ตั้ง false เมื่อขึ้น HTTPS จริง
DEBUG=false

# ===== Database =====
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/scopebot
# SQLite สำรองสำหรับ dev เร็ว
# DATABASE_URL=sqlite:///./scopebot.db
# Dev: true | Pilot/Production: false + ใช้ alembic upgrade head
AUTO_CREATE_TABLES=false

# ===== CORS / Frontend URL =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ใช้สร้างลิงก์รีเซ็ตรหัสผ่านในอีเมล
FRONTEND_URL=http://localhost:5173

# ===== JWT Auth =====
# สร้างด้วย: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=60

# ===== Admin bootstrap (create_admin.py) =====
ADMIN_EMAIL=admin@scopebot.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# true = อัปเดตรหัส admin ที่มีอยู่แล้วให้ตรง ADMIN_PASSWORD
ADMIN_UPDATE_PASSWORD=false

# ===== SMTP (ลืมรหัสผ่าน) — ถ้าไม่ตั้ง จะแจ้ง admin ในระบบแทน =====
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@yourcompany.com
# SMTP_USE_TLS=true

# ===== Ollama =====
# local: ปล่อยว่างได้ (default http://127.0.0.1:11434)
# Docker Compose: http://host.docker.internal:11434
# OLLAMA_HOST=http://127.0.0.1:11434

# ===== Docker Compose extras =====
# POSTGRES_PASSWORD=strong-db-password
# สำหรับ production ดู .env.production.example และ deploy/DEPLOY.md
