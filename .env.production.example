# คัดลอกเป็น .env ก่อนรัน:  copy .env.production.example .env
# แล้วแก้ค่าด้านล่างให้เป็นของจริง

# ===== บังคับต้องตั้ง =====
SECRET_KEY=
POSTGRES_PASSWORD=
ADMIN_PASSWORD=

# สร้าง SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ===== URL สาธารณะ (HTTPS ผ่าน Cloudflare Tunnel) =====
# ตัวอย่าง: https://scopebot.yourcompany.com
FRONTEND_URL=https://YOUR_DOMAIN
CORS_ORIGINS=https://YOUR_DOMAIN

# พอร์ตที่เปิด frontend (nginx ใน container)
HTTP_PORT=80

# ===== Cloudflare Tunnel (named) =====
# ได้จาก Zero Trust → Networks → Tunnels → Create
# ใช้กับ: docker compose -f docker-compose.yml -f docker-compose.tunnel.yml up -d
# Public Hostname ใน Cloudflare ต้องชี้ HTTP → frontend:80
CLOUDFLARE_TUNNEL_TOKEN=

# ===== Admin =====
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_USERNAME=admin
# true ครั้งเดียวหลัง deploy ถ้าต้องการบังคับเปลี่ยนรหัสตาม ADMIN_PASSWORD
ADMIN_UPDATE_PASSWORD=false

# ===== ความปลอดภัย =====
DEBUG=false
AUTO_CREATE_TABLES=false

# ===== LLM / RAG =====
MODEL_NAME=qwen2.5:1.5b
EMBEDDING_MODEL=BAAI/bge-m3
# Docker → Ollama บนเครื่อง host
OLLAMA_HOST=http://host.docker.internal:11434
# ถ้า Ollama อยู่ใน Docker network เดียวกัน เช่น:
# OLLAMA_HOST=http://ollama:11434

# ===== SMTP (แนะนำสำหรับลืมรหัสผ่าน) =====
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@yourcompany.com
# SMTP_USE_TLS=true
